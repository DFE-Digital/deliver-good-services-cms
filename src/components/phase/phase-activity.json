{
  "collectionName": "components_phase_phase_activities",
  "info": {
    "displayName": "Phase activity",
    "description": "Task/activity in a phase with profession tags, track, guidance and resources"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "description": "Brief hint shown on the card (e.g. 'First, before anything else in Explore')"
    },
    "description": {
      "type": "richtext"
    },
    "guidanceContent": {
      "type": "richtext",
      "description": "What, why, how and guidance (expandable section)"
    },
    "professionTags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tags-profession.tags-profession",
      "description": "DDaT roles involved (e.g. Product manager, User researcher)"
    },
    "trackTag": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tags-track.tags-track",
      "description": "Design, Build or Run track (optional)"
    },
    "related_content": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::detailed-guide.detailed-guide",
      "description": "Supporting guides"
    },
    "resources": {
      "type": "component",
      "component": "phase.phase-activity-resource",
      "repeatable": true,
      "description": "Downloads, artefacts, templates, case studies, links"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
