{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "metaDescription": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "leadImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "publishedFrom": {
      "type": "datetime"
    },
    "publishedTo": {
      "type": "datetime"
    },
    "author": {
      "type": "string"
    }
  }
}
