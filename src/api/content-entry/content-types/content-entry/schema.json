{
  "kind": "collectionType",
  "collectionName": "content_entries",
  "info": {
    "singularName": "content-entry",
    "pluralName": "content-entries",
    "displayName": "Content module"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "summary": {
      "type": "richtext"
    },
    "body": {
      "type": "richtext"
    },
    "entryType": {
      "type": "enumeration",
      "enum": [
        "Requirement",
        "Guidance",
        "Principle",
        "Consideration",
        "Standard point",
        "Assessment point",
        "Failure signal",
        "Evidence"
      ]
    },
    "strength": {
      "type": "enumeration",
      "enum": [
        "Must",
        "Should",
        "Could"
      ]
    },
    "priority": {
      "type": "enumeration",
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    "legalRequirement": {
      "type": "boolean"
    },
    "notes": {
      "type": "richtext"
    },
    "phases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tags-phase.tags-phase",
      "inversedBy": "content_entries"
    },
    "roles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tags-profession.tags-profession",
      "inversedBy": "content_entries"
    },
    "links": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::external-link.external-link"
    },
    "detailedGuides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::detailed-guide.detailed-guide"
    },
    "collections": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::collection.collection"
    },
    "artefacts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::artefact.artefact"
    }
  }
}
