{
  "kind": "collectionType",
  "collectionName": "tags_tracks",
  "info": {
    "singularName": "tags-track",
    "pluralName": "tags-tracks",
    "displayName": "Tags - Track",
    "description": "Track tag for lifecycle (Design, Build, Run)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "phases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::phase.phase",
      "mappedBy": "trackTags",
      "description": "Phases that use this track"
    }
  }
}
