{
  "kind": "collectionType",
  "collectionName": "detailed_guides",
  "info": {
    "singularName": "detailed-guide",
    "pluralName": "detailed-guides",
    "displayName": "Detailed guide"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 240,
      "required": true
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "overrideOverviewTitle": {
      "type": "string"
    },
    "detailed_guide_pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::detailed-guide-page.detailed-guide-page",
      "mappedBy": "detailed_guide"
    },
    "relatedContent": {
      "type": "component",
      "component": "content.related-content",
      "repeatable": true
    },
    "collection": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::collection.collection",
      "inversedBy": "detailed_guides"
    },
    "applicableProfessions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tags-profession.tags-profession",
      "inversedBy": "detailed_guides"
    },
    "showLastReviewedDateOnPage": {
      "type": "boolean",
      "default": false
    },
    "showApplicablePhasesOnPage": {
      "type": "boolean",
      "default": false
    },
    "lastReviewedDate": {
      "type": "date"
    },
    "userNeeds": {
      "type": "component",
      "component": "content.user-need",
      "repeatable": true
    },
    "contentOwner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::content-owner.content-owner",
      "inversedBy": "detailed_guides"
    },
    "hideContentsOnPrimaryPage": {
      "type": "boolean",
      "default": false
    },
    "relatedFiles": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files"
      ]
    },
    "showApplicableProfessionsOnPage": {
      "type": "boolean",
      "default": false
    },
    "showOwnerOnPage": {
      "type": "boolean",
      "default": true
    },
    "applicablePhases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tags-phase.tags-phase",
      "inversedBy": "detailed_guides"
    },
    "customJS": {
      "type": "text"
    },
    "customCSS": {
      "type": "text"
    },
    "showGuidePagesOnRight": {
      "type": "boolean",
      "default": false
    }
  }
}
