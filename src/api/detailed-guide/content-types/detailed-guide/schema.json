{
  "kind": "collectionType",
  "collectionName": "detailed_guides",
  "info": {
    "singularName": "detailed-guide",
    "pluralName": "detailed-guides",
    "displayName": "Detailed guide"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "detailed_guide_pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::detailed-guide-page.detailed-guide-page",
      "mappedBy": "detailed_guide"
    },
    "relatedContent": {
      "type": "component",
      "component": "content.related-content",
      "repeatable": true
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 240,
      "required": true
    },
    "userNeeds": {
      "type": "component",
      "component": "content.user-need",
      "repeatable": true
    },
    "applicable_phases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::phase.phase",
      "description": "Phases this guide applies to (for phase page listing)"
    },
    "guidePagesOnRightSide": {
      "type": "boolean",
      "default": false
    },
    "collection": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::collection.collection",
      "inversedBy": "detailed_guides"
    },
    "showLastUpdatedDateOnPage": {
      "type": "boolean"
    }
  }
}
