{
  "kind": "collectionType",
  "collectionName": "outputs",
  "info": {
    "singularName": "output",
    "pluralName": "outputs",
    "displayName": "Output",
    "description": "Artefact or output produced by a task"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "templateLink": {
      "type": "string",
      "description": "URL to template or resource"
    },
    "tasks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::task.task",
      "inversedBy": "outputs",
      "description": "Tasks that produce this output"
    }
  }
}
