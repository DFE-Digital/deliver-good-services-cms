{
  "kind": "collectionType",
  "collectionName": "tags_professions",
  "info": {
    "singularName": "tags-profession",
    "pluralName": "tags-professions",
    "displayName": "Tags - Profession"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "professionDescription": {
      "type": "richtext"
    },
    "plural": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "detailed_guide_pages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::detailed-guide-page.detailed-guide-page",
      "mappedBy": "applicableProfessions"
    },
    "job_specifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job-specification.job-specification",
      "mappedBy": "profession"
    },
    "collections": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::collection.collection",
      "mappedBy": "applicableProfessions"
    },
    "detailed_guides": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::detailed-guide.detailed-guide",
      "mappedBy": "applicableProfessions"
    },
    "guidance_areas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::guidance-area.guidance-area",
      "mappedBy": "featuredProfessions"
    }
  }
}
