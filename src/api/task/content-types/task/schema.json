{
  "kind": "collectionType",
  "collectionName": "tasks",
  "info": {
    "singularName": "task",
    "pluralName": "tasks",
    "displayName": "Task",
    "description": "Reusable canonical task content; placed in stages via Stage Task Placement"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "what": {
      "type": "richtext"
    },
    "whyItMatters": {
      "type": "richtext"
    },
    "howSteps": {
      "type": "component",
      "component": "task.how-step",
      "repeatable": true
    },
    "guidanceLinks": {
      "type": "component",
      "component": "shared.link-item",
      "repeatable": true
    },
    "notes": {
      "type": "richtext"
    },
    "track": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::track.track",
      "inversedBy": "tasks"
    },
    "roles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::role.role",
      "inversedBy": "tasks",
      "description": "Roles involved in this task"
    },
    "leadRole": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::role.role",
      "description": "Primary responsible role"
    },
    "outputs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::output.output",
      "mappedBy": "tasks",
      "description": "Default outputs for this task"
    },
    "placements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::stage-task-placement.stage-task-placement",
      "mappedBy": "task"
    }
  }
}
