{
  "kind": "collectionType",
  "collectionName": "navigation_items",
  "info": {
    "singularName": "navigation-item",
    "pluralName": "navigation-items",
    "displayName": "Navigation item"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::navigation-item.navigation-item",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::navigation-item.navigation-item",
      "mappedBy": "parent"
    },
    "collection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::collection.collection"
    },
    "detailed_guide": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::detailed-guide.detailed-guide"
    },
    "single_page_guide": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::single-page-guide.single-page-guide"
    },
    "html_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::html-page.html-page"
    },
    "externalUrl": {
      "type": "string"
    }
  }
}
