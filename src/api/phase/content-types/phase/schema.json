{
  "kind": "collectionType",
  "collectionName": "phases",
  "info": {
    "singularName": "phase",
    "pluralName": "phases",
    "displayName": "Phase",
    "description": "Lifecycle phase (e.g. Discovery, Alpha). Powers phase landing pages."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "sequence": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "hint": {
      "type": "text"
    },
    "summary": {
      "type": "richtext",
      "required": true
    },
    "purpose": {
      "type": "richtext"
    },
    "intent": {
      "type": "richtext"
    },
    "is_active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "activities": {
      "type": "component",
      "component": "phase.phase-activity",
      "repeatable": true
    },
    "mandatory_requirements": {
      "type": "component",
      "component": "phase.phase-requirement",
      "repeatable": true
    },
    "outputs": {
      "type": "component",
      "component": "phase.phase-output",
      "repeatable": true
    },
    "assurance": {
      "type": "component",
      "component": "phase.phase-assurance",
      "repeatable": false
    },
    "duration": {
      "type": "string"
    },
    "teamSize": {
      "type": "string",
      "description": "e.g. '1-3 people', 'Cross-functional team of 4-6'"
    },
    "trackTags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tags-track.tags-track",
      "inversedBy": "phases",
      "description": "Tracks active in this phase (Design, Build, Run)"
    },
    "relatedGuidance": {
      "type": "component",
      "component": "phase.related-link",
      "repeatable": true
    },
    "relatedStandards": {
      "type": "component",
      "component": "phase.related-link",
      "repeatable": true
    },
    "relatedTools": {
      "type": "component",
      "component": "phase.related-link",
      "repeatable": true
    },
    "relatedTraining": {
      "type": "component",
      "component": "phase.related-link",
      "repeatable": true
    }
  }
}
