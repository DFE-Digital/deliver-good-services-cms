{
  "kind": "collectionType",
  "collectionName": "single_page_guides",
  "info": {
    "singularName": "single-page-guide",
    "pluralName": "single-page-guides",
    "displayName": "Single page guide"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 60,
      "required": true,
      "unique": true
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 240,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "reviewComments": {
      "type": "text"
    },
    "lastReviewDate": {
      "type": "date"
    },
    "lastReviewBy": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "single_page_guide"
    },
    "nextReviewDate": {
      "type": "date"
    },
    "phaseTag": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tags-phase.tags-phase",
      "mappedBy": "single_page_guide"
    },
    "relatedContent": {
      "type": "component",
      "component": "content.related-content",
      "repeatable": true
    },
    "userNeeds": {
      "type": "component",
      "component": "content.user-need",
      "repeatable": true
    },
    "applicable_phases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::phase.phase",
      "description": "Phases this guide applies to (for phase page listing)"
    },
    "collection": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::collection.collection",
      "inversedBy": "single_page_guides"
    }
  }
}
