{
  "kind": "collectionType",
  "collectionName": "lifecycles",
  "info": {
    "singularName": "lifecycle",
    "pluralName": "lifecycles",
    "displayName": "Lifecycle",
    "description": "Top-level lifecycle (e.g. What to do when). Has many stages."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "richtext"
    },
    "ownerLabel": {
      "type": "string"
    },
    "audienceLabel": {
      "type": "string"
    },
    "lastUpdatedLabel": {
      "type": "string"
    },
    "defaultView": {
      "type": "enumeration",
      "enum": ["card", "list"],
      "default": "card"
    },
    "lucidResources": {
      "type": "component",
      "component": "shared.link-card",
      "repeatable": true
    },
    "stages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lifecycle-stage.lifecycle-stage",
      "mappedBy": "lifecycle"
    }
  }
}
