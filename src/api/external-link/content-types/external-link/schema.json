{
  "kind": "collectionType",
  "collectionName": "external_links",
  "info": {
    "singularName": "external-link",
    "pluralName": "external-links",
    "displayName": "Link"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "newTab": {
      "type": "boolean",
      "default": false
    },
    "externalLink": {
      "type": "boolean"
    },
    "description": {
      "type": "text"
    },
    "type": {
      "type": "enumeration",
      "default": "Guidance",
      "enum": [
        "Service",
        "Guidance",
        "Standard",
        "Policy",
        "Process"
      ]
    },
    "priorityInGroup": {
      "type": "boolean"
    }
  }
}
