{
  "kind": "collectionType",
  "collectionName": "collections",
  "info": {
    "singularName": "collection",
    "pluralName": "collections",
    "displayName": "Collection"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 70,
      "required": true,
      "unique": true
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 240,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "body": {
      "type": "richtext"
    },
    "applicablePhases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tags-phase.tags-phase",
      "inversedBy": "collections"
    },
    "sections": {
      "type": "component",
      "component": "collection.section",
      "repeatable": true
    },
    "relatedContent": {
      "type": "component",
      "component": "content.related-content",
      "repeatable": true
    },
    "userNeeds": {
      "type": "component",
      "component": "content.user-need",
      "repeatable": true
    },
    "detailed_guides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::detailed-guide.detailed-guide",
      "mappedBy": "collection"
    },
    "applicableProfessions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tags-profession.tags-profession",
      "inversedBy": "collections"
    },
    "lastReviewedDate": {
      "type": "date"
    },
    "lastReviewedBy": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "contentOwner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::content-owner.content-owner",
      "inversedBy": "collections"
    },
    "relatedFiles": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files"
      ]
    }
  }
}
