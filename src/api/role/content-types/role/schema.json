{
  "kind": "collectionType",
  "collectionName": "roles",
  "info": {
    "singularName": "role",
    "pluralName": "roles",
    "displayName": "Role",
    "description": "DDaT profession role for filtering and displaying task ownership"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "shortCode": {
      "type": "string",
      "description": "e.g. pm, dm, ur for filter chips"
    },
    "colourHex": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "tasks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::task.task",
      "mappedBy": "roles"
    }
  }
}
